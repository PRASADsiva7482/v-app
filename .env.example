# =============================================================================
# V-APP Environment Configuration Template
# =============================================================================
# This is a template file. Copy this to .env and fill in your actual values.
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Update the passwords in .env with your actual credentials
# 3. Never commit .env to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Driver (Common for all datasources)
# -----------------------------------------------------------------------------
DB_DRIVER=com.mysql.cj.jdbc.Driver

# -----------------------------------------------------------------------------
# Connection Pool Settings (Common for all datasources)
# -----------------------------------------------------------------------------
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=10

# -----------------------------------------------------------------------------
# CRM Datasource (Primary) - Initial
# -----------------------------------------------------------------------------
DB_CRM_URL=jdbc:mysql://mysql-1c840090-v-app.k.aivencloud.com:20632/v_app?zeroDateTimeBehavior=convertToNull&autoReconnect=true&useSSL=true&nullNamePatternMatchesAll=true&useUnicode=yes&requireSSL=true&allowPublicKeyRetrieval=true&sessionVariables=sql_require_primary_key=0&characterEncoding=UTF-8
DB_CRM_USERNAME=avnadmin
DB_CRM_PASSWORD=your_password_here

# -----------------------------------------------------------------------------
# CRM Datasource - Cellcard
# -----------------------------------------------------------------------------
DB_CRM_CELLCARD_URL=jdbc:mysql://mysql-1c840090-v-app.k.aivencloud.com:20632/v_app?zeroDateTimeBehavior=convertToNull&autoReconnect=true&useSSL=true&nullNamePatternMatchesAll=true&useUnicode=yes&requireSSL=true&allowPublicKeyRetrieval=true&sessionVariables=sql_require_primary_key=0&characterEncoding=UTF-8
DB_CRM_CELLCARD_USERNAME=avnadmin
DB_CRM_CELLCARD_PASSWORD=your_password_here


# -----------------------------------------------------------------------------
# Keycloak Datasource - Initial
# -----------------------------------------------------------------------------
DB_KEYCLOAK_URL=jdbc:mysql://mysql-1c840090-v-app.k.aivencloud.com:20632/keycloak?zeroDateTimeBehavior=convertToNull&autoReconnect=true&useSSL=true&nullNamePatternMatchesAll=true&useUnicode=yes&requireSSL=true&allowPublicKeyRetrieval=true&sessionVariables=sql_require_primary_key=0&characterEncoding=UTF-8
DB_KEYCLOAK_USERNAME=avnadmin
DB_KEYCLOAK_PASSWORD=your_password_here

# -----------------------------------------------------------------------------
# Keycloak Datasource - Cellcard
# -----------------------------------------------------------------------------
DB_KEYCLOAK_CELLCARD_URL=jdbc:mysql://mysql-1c840090-v-app.k.aivencloud.com:20632/keycloak?zeroDateTimeBehavior=convertToNull&autoReconnect=true&useSSL=true&nullNamePatternMatchesAll=true&useUnicode=yes&requireSSL=true&allowPublicKeyRetrieval=true&sessionVariables=sql_require_primary_key=0&characterEncoding=UTF-8
DB_KEYCLOAK_CELLCARD_USERNAME=avnadmin
DB_KEYCLOAK_CELLCARD_PASSWORD=your_password_here

# Media Storage Configuration (for social media features)
# -----------------------------------------------------------------------------
MEDIA_STORAGE_PATH=D:/project/uploaded_data

# -----------------------------------------------------------------------------
# Keycloak Public Key (for RS256 JWT Verification)
# -----------------------------------------------------------------------------
# Get this from Keycloak: http://localhost:8080/auth/realms/YOUR_REALM
# Look for "public_key" in the JSON response
# Or from Admin Console: Realm Settings -> Keys -> RS256 -> Public Key
# Copy the FULL key including -----BEGIN PUBLIC KEY----- and -----END PUBLIC KEY-----
KEYCLOAK_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# VPN / Network Access Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: When accessing v-app through VPN (WireGuard, OpenVPN, etc.):
# 
# 1. Update Keycloak Server URL in application-keycloak.properties:
#    - Change from: keycloak.auth-server-url=http://localhost:8080
#    - Change to: keycloak.auth-server-url=http://<VPN_SERVER_IP>:8080
#    
#    Examples:
#      WireGuard VPN: http://10.8.0.1:8080
#      LAN IP: http://192.168.1.100:8080
#      Public IP: http://YOUR_PUBLIC_IP:8080
#
# 2. Ensure Keycloak is also configured to accept connections from VPN clients:
#    - Update Keycloak's Valid Redirect URIs to include VPN client IPs
#    - Update Web Origins to allow CORS from VPN client IPs
#
# 3. The server is configured to bind to 0.0.0.0 (all interfaces)
#    - See server.address=0.0.0.0 in application.properties
#    - This allows connections from VPN and LAN
#
# 4. CORS is configured to allow all origins in development
#    - See application-cpdetails.yml (allowAll: true)
#    - In production, specify exact allowed origins for security
#
# 5. Firewall Configuration:
#    - Ensure port 2000 (v-app) is open in firewall
#    - Ensure port 8080 (Keycloak) is open in firewall
#    - Ensure port 6379 (Redis) is open in firewall
#    - For WireGuard: Allow traffic through wg0 interface
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Redis Configuration (for caching)
# -----------------------------------------------------------------------------
# Redis is used for caching to improve performance across multiple instances
# When using Redis with VPN (multiple laptops accessing same Redis):
#
# 1. Run Redis in Docker (on server machine):
#    docker-compose up -d redis
#
# 2. Redis is already configured in application-redis.properties:
#    spring.data.redis.host=100.122.105.63  (VPN server IP)
#    spring.data.redis.port=6379
#
# 3. For localhost development, change in application-redis.properties:
#    spring.data.redis.host=localhost
#
# 4. Redis configuration (all laptops use same Redis server):
#    - Server laptop (VPN IP): Runs Redis in Docker
#    - Laptop 1 (local): Connects to 100.122.105.63:6379
#    - Laptop 2 (VPN): Connects to 100.122.105.63:6379
#
# 5. Open firewall port for Redis:
#    Windows: New-NetFirewallRule -DisplayName "Redis Server" -Direction Inbound -LocalPort 6379 -Protocol TCP -Action Allow
#    Linux: sudo ufw allow 6379/tcp
#
# Optional Redis Configuration:
REDIS_HOST=100.122.105.63
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# -----------------------------------------------------------------------------



# =============================================================================
# PLATFORM-SPECIFIC NOTES:
# =============================================================================
# 
# Docker/Docker Compose:
# - Use docker-compose.yml env_file directive
# - Or use environment: section with ${VAR_NAME}
#
# Kubernetes:
# - Create ConfigMap for non-sensitive data
# - Create Secret for passwords
# - Use envFrom in deployment.yaml
#
# Render.com / Heroku / Railway:
# - Copy these variable names and values to platform's environment config
#
# AWS ECS / Lambda:
# - Add to task definition environment variables
#
# Local Development:
# - Load .env file automatically with your IDE or dotenv library
# =============================================================================
